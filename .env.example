# WordPress username used for REST API authentication.
WORDPRESS_USERNAME=

# WordPress Application Password used for REST API authentication.
WORDPRESS_APP_PASSWORD=

# Base URL of the target WordPress site.
WORDPRESS_SITE_URL=

# Short site slug used as the NotebookLM notebook title prefix.
WORDPRESS_SITE_SLUG=localhost7007

# TMDB API read access token.
TMDB_API_TOKEN=

# Default podcast language when --lang is not provided.
PODCAST_LANG=zh-CN

# Allowed resource types for --type. Use comma-separated values.
TYPES=tv,movie

# Source regions to query from TMDB. Use comma-separated ISO 3166-1 codes.
REGIONS=US,JP,CN

# Only fetch resources released on or after this date.
RESOURCE_START_DATE=2025-06-25

# Minimum TMDB vote_average required for a resource to be selected.
RESOURCE_START_SCORE=7

# Local directory used to store the SQLite database, posters, audio files, and logs.
STORAGE_DIR=./storage
